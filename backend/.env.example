# ──────────────────────────────────────────────────────────────────────────────
# RoboticGen Hobby Server Monitor — Environment Variables
#
# Copy this file to .env and fill in the values.
# On production (systemd), set these via EnvironmentFile=/etc/hsm/hsm.env
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Authentication ─────────────────────────────────────────────────────────
# JWT signing secret. Must be at least 32 random bytes.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-here-replace-me

# JWT session lifetime in seconds (default: 8 hours = 28800)
JWT_EXPIRY_SECONDS=28800

# The Google email of the first admin user.
# The first person to sign in WITH THIS EXACT EMAIL becomes admin.
# After any admin exists, this variable has no effect (bootstrap is disabled).
BOOTSTRAP_ADMIN_EMAIL=your.email@gmail.com

# ── Email Integration ──────────────────────────────────────────────────────
# Used for inviting users.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application type).
# Add http://localhost:8000/api/auth/callback as an Authorized Redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Must exactly match what's registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── LXD ───────────────────────────────────────────────────────────────────
# Leave empty for auto-detection (tries Snap path then deb path).
# Set explicitly if you're using a non-standard LXD installation.
# Snap LXD:  /var/snap/lxd/common/lxd/unix.socket
# Deb LXD:   /var/lib/lxd/unix.socket
LXD_SOCKET_PATH=

# Set to "mock" to use fake LXD data for development without LXD installed.
# Set to "real" (default) for production.
LXD_MODE=real

# LXD API call timeout in seconds
LXD_TIMEOUT=120

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite database file path (created automatically)
DB_PATH=data/app.db

# SQLite metrics database file path (created automatically)
TSDB_PATH=data/metrics.db

# JSON live cache file (written by collector, read by API)
LIVE_CACHE_PATH=data/live_cache.json

# ── Metric Collector ────────────────────────────────────────────────────────
# How often to poll LXD for metrics (seconds). Default: 10
COLLECTOR_INTERVAL_SECONDS=10

# How many days of raw metric data to keep before compacting to hourly averages.
# Default: 7 (7 days of 10-second resolution)
METRICS_RAW_DAYS=7

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set to "true" in HTTPS production environments to add Secure flag to cookies.
# Leave as "false" for local HTTP development.
COOKIE_SECURE=false

# ── Frontend ───────────────────────────────────────────────────────────────
# Path to the built Astro frontend (relative to backend/)
STATIC_DIR=../frontend/dist
