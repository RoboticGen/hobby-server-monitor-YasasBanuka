---
/**
 * Login page — shown to unauthenticated users.
 * 
 * Design: Centered card with Google sign-in button. No form fields needed
 * since we use OAuth — the user just clicks and authorizes on Google.
 * 
 * This is NOT behind AuthMiddleware (it's in the allowlist).
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Hobby Server Monitor</title>
    <meta name="description" content="Sign in to the Hobby Server Monitor admin dashboard" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="login-bg">
      <!-- Animated background grid -->
      <div class="grid-overlay" aria-hidden="true"></div>
      
      <!-- Glow orbs -->
      <div class="orb orb-1" aria-hidden="true"></div>
      <div class="orb orb-2" aria-hidden="true"></div>

      <div class="login-card" role="main">
        <!-- Logo / Brand -->
        <div class="brand">
          <div class="brand-logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h1 class="brand-name">Hobby Server Monitor</h1>
        </div>

        <p class="tagline">LXD container management for your home lab</p>

        <!-- Feature highlights -->
        <ul class="features" aria-label="Features">
          <li>
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.749.749 0 1 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
            </svg>
            Real-time container metrics
          </li>
          <li>
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.749.749 0 1 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
            </svg>
            Lifecycle management (start, stop, restart)
          </li>
          <li>
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.749.749 0 1 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
            </svg>
            Role-based access control
          </li>
          <li>
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.749.749 0 1 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
            </svg>
            Historical performance charts
          </li>
        </ul>

        <!-- Sign-in button -->
        <a href="/api/auth/login" class="google-btn" id="signin-btn" role="button">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </a>

        <p class="access-note">
          Access is by invitation only. Contact an administrator if you need access.
        </p>
      </div>
    </div>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: #0d1117;
        color: #e6edf3;
        height: 100vh;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .login-bg {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        position: relative;
      }

      /* Subtle dot-grid background */
      .grid-overlay {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(48, 54, 61, 0.6) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
      }

      /* Ambient glow orbs */
      .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: float 8s ease-in-out infinite;
      }

      .orb-1 {
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(56, 139, 253, 0.15) 0%, transparent 70%);
        top: -100px; left: -100px;
      }

      .orb-2 {
        width: 350px; height: 350px;
        background: radial-gradient(circle, rgba(188, 140, 255, 0.12) 0%, transparent 70%);
        bottom: -80px; right: -60px;
        animation-delay: -4s;
      }

      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-20px); }
      }

      /* Login card */
      .login-card {
        position: relative;
        z-index: 10;
        background: rgba(22, 27, 34, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(48, 54, 61, 0.8);
        border-radius: 20px;
        padding: 40px;
        width: min(400px, calc(100vw - 40px));
        box-shadow:
          0 0 0 1px rgba(255,255,255,0.04) inset,
          0 20px 60px rgba(0,0,0,0.6);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 10px;
      }

      .brand-logo {
        width: 44px; height: 44px;
        background: linear-gradient(135deg, #388bfd 0%, #bc8cff 100%);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 12px rgba(56, 139, 253, 0.3);
      }

      .brand-logo svg { width: 24px; height: 24px; stroke: white; }

      .brand-name {
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
        color: #e6edf3;
      }

      .tagline {
        font-size: 13px;
        color: #8b949e;
        margin-bottom: 24px;
        margin-top: 2px;
      }

      .features {
        list-style: none;
        margin-bottom: 28px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .features li {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: #8b949e;
      }

      .features li svg {
        width: 14px; height: 14px;
        flex-shrink: 0;
        color: #3fb950;
      }

      .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 12px 20px;
        background: #fff;
        color: #3c4043;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        font-family: inherit;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.15s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        user-select: none;
      }

      .google-btn:hover {
        background: #f8f8f8;
        box-shadow: 0 4px 16px rgba(0,0,0,0.4);
        transform: translateY(-1px);
      }

      .google-btn:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
      }

      .google-btn svg { width: 20px; height: 20px; }

      .access-note {
        margin-top: 16px;
        font-size: 11px;
        color: #484f58;
        text-align: center;
        line-height: 1.5;
      }
    </style>

    <script>
      // If already authenticated, redirect to dashboard
      (async function() {
        try {
          const res = await fetch('/healthz');
          if (res.ok) {
            // Check if we actually have a valid session
            const authRes = await fetch('/api/metrics/live');
            if (authRes.ok) {
              window.location.href = '/dashboard';
            }
          }
        } catch (e) {
          // Not authenticated, stay on login page
        }
      })();
    </script>
  </body>
</html>
