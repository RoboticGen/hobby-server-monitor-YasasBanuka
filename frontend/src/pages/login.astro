---
/**
 * Login page — shown to unauthenticated users.
 * 
 * Design: Centered card with Google sign-in button.
 * Matches the strict, high-contrast monochrome Zinc aesthetic.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Hobby Server Monitor</title>
    <meta name="description" content="Sign in to the Hobby Server Monitor admin dashboard" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="login-bg">
      <div class="login-card" role="main">
        <!-- Logo / Brand -->
        <div class="brand">
          <div class="brand-logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h1 class="brand-name">Hobby Server Monitor</h1>
        </div>

        <p class="tagline">Sign in to manage your LXD infrastructure.</p>

        <div id="error-alert" style="display:none; align-items:center; gap:8px; background-color:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.2); color:#ef4444; border-radius:6px; padding:10px 12px; font-size:12px; margin-bottom:20px; text-align:left;">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" style="flex-shrink:0;">
            <path d="M2.343 13.657A8 8 0 1 1 13.658 2.343 8 8 0 0 1 2.343 13.657ZM6.03 4.97a.751.751 0 0 0-1.042.018.751.751 0 0 0-.018 1.042L6.94 8 4.97 9.97a.749.749 0 0 0 .326 1.275.749.749 0 0 0 .734-.215L8 9.06l1.97 1.97a.749.749 0 0 0 1.275-.326.749.749 0 0 0-.215-.734L9.06 8l1.97-1.97a.749.749 0 0 0-.326-1.275.749.749 0 0 0-.734.215L8 6.94Z"/>
          </svg>
          <span id="error-message"></span>
        </div>

        <!-- Sign-in button -->
        <a href="/api/auth/login" class="google-btn" id="signin-btn" role="button">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </a>

        <p class="access-note">
          Access is restricted to authorized administrators.
        </p>
      </div>
    </div>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: #09090b; /* Zinc 950 */
        color: #fafafa;
        height: 100vh;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .login-bg {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        position: relative;
        background-image: radial-gradient(circle, rgba(39, 39, 42, 0.5) 1px, transparent 1px);
        background-size: 24px 24px;
      }

      /* Login card */
      .login-card {
        background: #18181b; /* Zinc 900 */
        border: 1px solid #27272a; /* Zinc 800 */
        border-radius: 8px;
        padding: 40px;
        width: min(380px, calc(100vw - 40px));
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        margin-bottom: 8px;
      }

      .brand-logo {
        width: 48px; height: 48px;
        background: #fafafa;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
      }

      .brand-logo svg { width: 24px; height: 24px; stroke: #09090b; }

      .brand-name {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #fafafa;
      }

      .tagline {
        font-size: 13px;
        color: #a1a1aa;
        margin-bottom: 32px;
      }

      .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 10px 16px;
        background: #fafafa;
        color: #09090b;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        font-family: inherit;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: background 0.15s ease;
        user-select: none;
      }

      .google-btn:hover {
        background: #e4e4e7; /* Zinc 200 */
      }

      .google-btn svg { width: 18px; height: 18px; }

      .access-note {
        margin-top: 24px;
        font-size: 11px;
        color: #71717a; /* Zinc 500 */
        line-height: 1.5;
      }
    </style>

    <script>
      (async function() {
        const urlParams = new URLSearchParams(window.location.search);
        const errCode = urlParams.get('error');
        if (errCode) {
          const alertEl = document.getElementById('error-alert');
          const msgEl = document.getElementById('error-message');
          
          if (errCode === 'not_invited') {
            msgEl.textContent = 'Your account has not been invited. Contact an administrator to request access.';
          } else if (errCode === 'inactive') {
            msgEl.textContent = 'Your account has been deactivated.';
          } else if (errCode === 'invalid_state') {
            msgEl.textContent = 'Sign in failed due to a security mismatch. Please try again.';
          } else {
            msgEl.textContent = 'An unknown authentication error occurred.';
          }
          alertEl.style.display = 'flex';
          window.history.replaceState({}, document.title, window.location.pathname);
        }

        try {
          const res = await fetch('/healthz');
          if (res.ok) {
            const authRes = await fetch('/api/metrics/live');
            if (authRes.ok) {
              window.location.href = '/dashboard';
            }
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
