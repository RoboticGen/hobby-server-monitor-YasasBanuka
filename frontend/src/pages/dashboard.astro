---
/**
 * Main dashboard page.
 * 
 * Shows all containers the user has access to with:
 * - Live status (Running/Stopped/Frozen/Error)
 * - CPU, RAM, Network usage bars
 * - Quick action buttons (start/stop)
 * - Automatic refresh every 15 seconds
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard">
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle" id="last-updated">Loading containers...</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
      <div class="lxd-status" id="lxd-status">
        <span class="status-dot"></span>
        <span class="status-text">LXD</span>
      </div>
      <a href="/containers/create" class="btn btn-primary" id="create-btn" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="16"/>
          <line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
        New Container
      </a>
    </div>
  </div>

  <!-- Host Node Overview -->
  <div class="card" id="host-overview-card" style="display:none; margin-bottom: 24px; padding: 20px;">
    <h2 class="card-section-title" style="margin-bottom: 16px;">Host Node Overview (Allocation vs Capacity)</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      
      <div>
        <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
          <span style="font-size:13px; font-weight:600; color:var(--text-color);">RAM Allocation</span>
          <span style="font-size:12px; color:var(--text-muted);" id="host-ram-text">—</span>
        </div>
        <div style="height:8px; background:var(--bg-secondary); border-radius:4px; overflow:hidden;">
          <div id="host-ram-bar" style="height:100%; width:0%; background:var(--brand-primary); transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div>
        <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
          <span style="font-size:13px; font-weight:600; color:var(--text-color);">CPU Core Allocation</span>
          <span style="font-size:12px; color:var(--text-muted);" id="host-cpu-text">—</span>
        </div>
        <div style="height:8px; background:var(--bg-secondary); border-radius:4px; overflow:hidden;">
          <div id="host-cpu-bar" style="height:100%; width:0%; background:var(--brand-secondary); transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div>
        <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
          <span style="font-size:13px; font-weight:600; color:var(--text-color);">Disk Space</span>
          <span style="font-size:12px; color:var(--text-muted);" id="host-disk-text">—</span>
        </div>
        <div style="height:8px; background:var(--bg-secondary); border-radius:4px; overflow:hidden;">
          <div id="host-disk-bar" style="height:100%; width:100%; background:var(--success-color); opacity: 0.5;"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- LXD unavailable banner -->
  <div class="alert alert-warning" id="lxd-warning" style="display:none;">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
      <path d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575Zm1.763.707a.25.25 0 0 0-.44 0L1.698 13.132a.25.25 0 0 0 .22.368h12.164a.25.25 0 0 0 .22-.368Zm.53 3.996v2.5a.75.75 0 0 1-1.5 0v-2.5a.75.75 0 0 1 1.5 0ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/>
    </svg>
    LXD is unreachable — showing last known state.
  </div>

  <!-- Container Table -->
  <div class="table-container" id="container-table-wrapper">
    <table id="container-table">
      <thead>
        <tr>
          <th>Name / Image</th>
          <th>Status</th>
          <th>CPU</th>
          <th>Memory</th>
          <th>Network</th>
          <th>Disk</th>
          <th style="width: 80px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody id="container-tbody">
        <!-- Skeletons shown while loading -->
        <tr>
          <td><div class="skeleton" style="height:14px; width:120px; margin-bottom:4px;"></div><div class="skeleton" style="height:10px; width:80px;"></div></td>
          <td><div class="skeleton" style="height:20px; width:60px;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:28px; width:60px;"></div></td>
        </tr>
        <tr>
          <td><div class="skeleton" style="height:14px; width:140px; margin-bottom:4px;"></div><div class="skeleton" style="height:10px; width:60px;"></div></td>
          <td><div class="skeleton" style="height:20px; width:60px;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:14px; width:100%;"></div></td>
          <td><div class="skeleton" style="height:28px; width:60px;"></div></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Empty state -->
  <div id="empty-state" style="display:none;" class="empty-state">
    <div class="empty-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
      </svg>
    </div>
    <h3>No containers yet</h3>
    <p id="empty-state-text">Loading...</p>
    <a href="/containers/create" class="btn btn-primary" id="empty-create-btn" style="display:none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="16"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
      Create Container
    </a>
  </div>

  <!-- Confirm action modal -->
  <div class="modal-overlay" id="confirm-modal">
    <div class="modal">
      <h2 class="modal-title" id="modal-title">Confirm Action</h2>
      <p id="modal-body" style="color: var(--text-secondary); font-size: 14px;"></p>
      <div class="modal-actions">
        <button class="btn btn-secondary" id="modal-cancel">Cancel</button>
        <button class="btn btn-primary" id="modal-confirm">Confirm</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── LXD status indicator ────────────────────────────────────────────── */
  .lxd-status {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--status-stopped);
    transition: background var(--transition-normal);
  }

  .lxd-status.connected .status-dot   { background: var(--status-running); box-shadow: 0 0 6px var(--status-running); }
  .lxd-status.error .status-dot       { background: var(--status-error); }

  /* ── Table styles overrides (others inherit from BaseLayout) ──────────────── */
  .container-name-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .container-name-col .name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
  }
  .container-name-col .name:hover {
    color: var(--accent-blue-light);
  }
  .container-name-col .image {
    font-size: 11px;
    color: var(--text-muted);
  }

  .stat-block {
    display: flex;
    flex-direction: column;
    gap: 6px; /* Increased gap */
    width: 140px; /* Increased width for better column alignment */
  }
  .stat-block .value {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-secondary);
  }
  
  .net-block {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    gap: 4px; /* Increased gap */
  }

  .limits-block {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 4px; /* Increased gap */
  }
  .limits-block span {
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-secondary);
  }

  .table-actions {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
  }

  /* ── Stopped state row opacity ───────────────────────────────────────── */
  tr.status-stopped td {
    opacity: 0.7;
  }
  tr.status-stopped:hover td {
    opacity: 1;
  }

  /* ── Empty state ─────────────────────────────────────────────────────── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
    gap: 12px;
  }

  .empty-icon {
    width: 56px; height: 56px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
  }

  .empty-icon svg { width: 28px; height: 28px; }

  .empty-state h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .empty-state p {
    font-size: 14px;
    color: var(--text-secondary);
  }
</style>

<script>
  /**
   * Dashboard live update script.
   *
   * Polls /api/metrics/live every 15 seconds and re-renders container cards.
   * Also fetches container list once on load for full config data.
   */

  let currentUser = null;
  let currentUserRole = null;
  let containers = {};  // name → container data
  let lastContainers = [];
  let hostCapacity = null;
  let lxdAvailable = true;
  let pollTimer = null;

  // Color for usage bars based on percentage
  function barColor(pct) {
    if (pct >= 90) return 'bar-red';
    if (pct >= 70) return 'bar-yellow';
    return 'bar-blue';
  }

  function formatBytes(bytes) {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes/1024).toFixed(1)} KB`;
    if (bytes < 1024 * 1024 * 1024) return `${(bytes/1024/1024).toFixed(1)} MB`;
    return `${(bytes/1024/1024/1024).toFixed(2)} GB`;
  }

  function statusBadge(status) {
    const map = {
      'Running': 'badge-running',
      'Stopped': 'badge-stopped',
      'Frozen':  'badge-frozen',
      'Error':   'badge-error',
    };
    return `<span class="badge ${map[status] || 'badge-stopped'}">${status}</span>`;
  }

  function renderRow(container, metrics) {
    const name = container.name;
    const status = container.status;
    const isRunning = status === 'Running';
    const limits = container.limits || {};

    const cpu = metrics?.cpu_usage_pct ?? 0;
    const ramUsed = metrics?.ram_used_mb ?? 0;
    const ramLimit = limits.ram_mb || 1;
    const ramPct = Math.min(100, (ramUsed / ramLimit) * 100);
    const diskUsed = metrics?.disk_used_gb ?? 0;
    const diskLimit = limits.disk_gb || 1;
    const diskPct = Math.min(100, (diskUsed / diskLimit) * 100);
    const netRx = metrics?.net_rx_rate_bps ?? 0;
    const netTx = metrics?.net_tx_rate_bps ?? 0;

    let actionBtns = '';
    if (currentUserRole === 'admin') {
      if (status === 'Running') {
        actionBtns = `
          <div class="table-actions" id="actions-${name}">
            <button class="btn btn-sm btn-secondary" onclick="event.preventDefault(); triggerAction('${name}', 'stop')">Stop</button>
            <button class="btn btn-sm btn-secondary" onclick="event.preventDefault(); triggerAction('${name}', 'restart')">Restart</button>
            <button class="btn btn-sm btn-secondary" onclick="event.preventDefault(); triggerAction('${name}', 'freeze')">Freeze</button>
          </div>`;
      } else if (status === 'Frozen') {
        actionBtns = `
          <div class="table-actions" id="actions-${name}">
            <button class="btn btn-sm btn-secondary" onclick="event.preventDefault(); triggerAction('${name}', 'unfreeze')">Unfreeze</button>
            <button class="btn btn-sm btn-secondary" onclick="event.preventDefault(); triggerAction('${name}', 'stop')">Stop</button>
          </div>`;
      } else {
        actionBtns = `
          <div class="table-actions" id="actions-${name}">
            <button class="btn btn-sm btn-primary" onclick="event.preventDefault(); triggerAction('${name}', 'start')">Start</button>
          </div>`;
      }
    }

    return `
      <tr class="status-${status.toLowerCase()}" onclick="window.location.href='/containers/detail?name=${name}'" style="cursor: pointer;">
        <td>
          <div class="container-name-col">
            <a href="/containers/detail?name=${name}" class="name" onclick="event.stopPropagation()">${name}</a>
            <span class="image">${container.image || '-'}</span>
          </div>
        </td>
        <td>${statusBadge(status)}</td>
        <td>
          ${isRunning ? `
            <div class="stat-block">
              <span class="value">${cpu.toFixed(1)}%</span>
              <div class="stat-bar"><div class="stat-bar-fill ${barColor(cpu)}" style="width:${cpu}%;"></div></div>
            </div>
          ` : `<span style="color:var(--text-muted);font-size:11px;">-</span>`}
        </td>
        <td>
          ${isRunning ? `
            <div class="stat-block">
              <span class="value">${ramUsed} / ${limits.ram_mb ?? '?'} MB</span>
              <div class="stat-bar"><div class="stat-bar-fill ${barColor(ramPct)}" style="width:${ramPct}%;"></div></div>
            </div>
          ` : `<span style="color:var(--text-muted);font-size:11px;">-</span>`}
        </td>
        <td>
          ${isRunning ? `
            <div class="net-block">
              <span>↓ ${formatBytes(netRx*8)}/s</span>
              <span>↑ ${formatBytes(netTx*8)}/s</span>
            </div>
          ` : `<span style="color:var(--text-muted);font-size:11px;">-</span>`}
        </td>
        <td>
          ${isRunning ? `
            <div class="stat-block">
              <span class="value">${diskUsed.toFixed(1)} / ${limits.disk_gb ?? '?'} GB</span>
              <div class="stat-bar"><div class="stat-bar-fill ${barColor(diskPct)}" style="width:${diskPct}%;"></div></div>
            </div>
          ` : `<span style="color:var(--text-muted);font-size:11px;">-</span>`}
        </td>
        <td onclick="event.stopPropagation()">
          ${actionBtns}
        </td>
      </tr>
    `;
  }

  async function loadContainers() {
    try {
      const res = await fetch('/api/containers');
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) return;
      const data = await res.json();
      lastContainers = data.containers;
      // Build a map by name
      data.containers.forEach(c => { containers[c.name] = c; });
      updateHostOverview(data.containers);
    } catch (e) {
      console.error('Failed to load containers:', e);
    }
  }

  async function loadCurrentUser() {
    try {
      const res = await fetch('/api/users/me');
      if (!res.ok) return;
      const user = await res.json();
      currentUser = user;
      currentUserRole = user.role;
      
      const emptyStateText = document.getElementById('empty-state-text');
      
      if (currentUserRole === 'admin') {
        if (emptyStateText) emptyStateText.textContent = 'Create your first container to get started.';
        document.getElementById('create-btn')?.style.setProperty('display', 'inline-flex');
        document.getElementById('empty-create-btn')?.style.setProperty('display', 'inline-flex');
        document.getElementById('host-overview-card')?.style.setProperty('display', 'block');
        fetchHostCapacity();
      } else {
        if (emptyStateText) emptyStateText.textContent = 'You have no containers assigned to you. Please contact your administrator.';
      }
    } catch (e) {}
  }

  async function fetchHostCapacity() {
    try {
      const res = await fetch('/api/host/capacity');
      if (res.ok) {
        hostCapacity = await res.json();
        updateHostOverview(Object.values(containers));
      }
    } catch (e) {
      console.error("Failed to fetch host capacity:", e);
    }
  }

  function updateHostOverview(containers) {
    if (!hostCapacity || currentUserRole !== 'admin') return;

    let totalAllocatedRam = 0;
    let totalAllocatedCpu = 0;
    let totalAllocatedDisk = 0;

    containers.forEach(c => {
      if (c.limits) {
        totalAllocatedRam += (c.limits.ram_mb || 0);
        totalAllocatedCpu += (c.limits.cpu_cores || 0);
        totalAllocatedDisk += (c.limits.disk_gb || 0);
      }
    });

    const ramPct = Math.min(100, Math.round((totalAllocatedRam / hostCapacity.ram_mb) * 100)) || 0;
    const cpuPct = Math.min(100, Math.round((totalAllocatedCpu / hostCapacity.cpu_cores) * 100)) || 0;
    const diskPct = Math.min(100, Math.round((totalAllocatedDisk / hostCapacity.disk_gb) * 100)) || 0;

    document.getElementById('host-ram-text').textContent = `${totalAllocatedRam} MB / ${hostCapacity.ram_mb} MB (${ramPct}%)`;
    document.getElementById('host-cpu-text').textContent = `${totalAllocatedCpu} / ${hostCapacity.cpu_cores} Cores (${cpuPct}%)`;
    document.getElementById('host-disk-text').textContent = `${totalAllocatedDisk} GB / ${hostCapacity.disk_gb} GB (${diskPct}%)`;

    const ramBar = document.getElementById('host-ram-bar');
    ramBar.style.width = `${ramPct}%`;
    if (ramPct >= 100) ramBar.style.background = 'var(--accent-red)';
    else if (ramPct >= 85) ramBar.style.background = 'var(--accent-yellow)';
    else ramBar.style.background = 'var(--accent-blue-light)';

    const cpuBar = document.getElementById('host-cpu-bar');
    cpuBar.style.width = `${cpuPct}%`;
    if (cpuPct >= 100) cpuBar.style.background = 'var(--accent-red)';
    else if (cpuPct >= 85) cpuBar.style.background = 'var(--accent-yellow)';
    else cpuBar.style.background = 'var(--accent-blue-light)';

    const diskBar = document.getElementById('host-disk-bar');
    diskBar.style.width = `${diskPct}%`;
    diskBar.style.opacity = '1';
    if (diskPct >= 100) diskBar.style.background = 'var(--accent-red)';
    else if (diskPct >= 85) diskBar.style.background = 'var(--accent-yellow)';
    else diskBar.style.background = 'var(--accent-green)';
  }

  async function pollMetrics() {
    try {
      const res = await fetch('/api/metrics/live');
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) return;

      const data = await res.json();
      lxdAvailable = data.lxd_available !== false;

      // Update LXD status indicator
      const statusEl = document.getElementById('lxd-status');
      if (statusEl) {
        statusEl.className = 'lxd-status ' + (lxdAvailable ? 'connected' : 'error');
        statusEl.querySelector('.status-text').textContent = lxdAvailable ? 'LXD' : 'LXD Offline';
      }

      document.getElementById('lxd-warning')?.style.setProperty('display', lxdAvailable ? 'none' : 'flex');

      // Merge live metrics with container config
      const metricsMap = {};
      (data.metrics || []).forEach(m => { metricsMap[m.container] = m; });

      // Also merge container data (from metrics for names)
      (data.metrics || []).forEach(m => {
        if (!containers[m.container]) {
          containers[m.container] = { name: m.container, status: m.status, limits: {} };
        }
        containers[m.container].status = m.status || containers[m.container].status;
      });

      // Render table rows
      const tableWrapper = document.getElementById('container-table-wrapper');
      const tbody = document.getElementById('container-tbody');
      const emptyState = document.getElementById('empty-state');
      const names = Object.keys(containers);

      if (names.length === 0) {
        if (tableWrapper) tableWrapper.style.display = 'none';
        if (emptyState) emptyState.style.display = 'flex';
      } else {
        if (emptyState) emptyState.style.display = 'none';
        if (tableWrapper) tableWrapper.style.display = 'block';
        if (tbody) {
          tbody.innerHTML = names
            .sort()
            .map(name => renderRow(containers[name], metricsMap[name]))
            .join('');
        }
      }

      const now = new Date();
      const updated = document.getElementById('last-updated');
      if (updated) {
        updated.textContent = `${names.length} container${names.length !== 1 ? 's' : ''} · updated ${now.toLocaleTimeString()}`;
      }

    } catch (e) {
      console.error('Poll failed:', e);
    }
  }

  async function triggerAction(name, action) {
    const modal = document.getElementById('confirm-modal');
    const title = document.getElementById('modal-title');
    const body  = document.getElementById('modal-body');
    const confirmBtn = document.getElementById('modal-confirm');
    const cancelBtn  = document.getElementById('modal-cancel');

    const messages = {
      stop:    { title: `Stop ${name}?`, body: 'The container will be stopped gracefully.', btnClass: 'btn-danger' },
      start:   { title: `Start ${name}?`, body: 'The container will be started.', btnClass: 'btn-primary' },
      restart: { title: `Restart ${name}?`, body: 'The container will be restarted.', btnClass: 'btn-danger' },
    };
    const msg = messages[action] || { title: `${action} ${name}?`, body: '', btnClass: 'btn-primary' };

    title.textContent = msg.title;
    body.textContent = msg.body;
    confirmBtn.className = `btn ${msg.btnClass}`;
    modal.classList.add('open');

    return new Promise(resolve => {
      const doConfirm = async () => {
        modal.classList.remove('open');
        try {
          const res = await fetch(`/api/containers/${name}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action }),
          });
          if (!res.ok) {
            const err = await res.json();
            alert(`Failed: ${err.description || err.error}`);
          }
        } catch (e) { alert(`Error: ${e.message}`); }
        await loadContainers(); // Fetch immediate status change from API
        await pollMetrics();    // Re-render table
        cleanup();
        resolve();
      };
      const doCancel = () => { modal.classList.remove('open'); cleanup(); resolve(); };
      const cleanup = () => {
        confirmBtn.removeEventListener('click', doConfirm);
        cancelBtn.removeEventListener('click', doCancel);
      };
      confirmBtn.addEventListener('click', doConfirm);
      cancelBtn.addEventListener('click', doCancel);
    });
  }

  // Expose for inline onclick
  window.triggerAction = triggerAction;

  // Initialize
  (async () => {
    await loadCurrentUser();
    await loadContainers();
    await pollMetrics();
    // Poll every 15 seconds
    pollTimer = setInterval(pollMetrics, 15000);
  })();

  // Cleanup on page unload
  window.addEventListener('beforeunload', () => { if (pollTimer) clearInterval(pollTimer); });
</script>
