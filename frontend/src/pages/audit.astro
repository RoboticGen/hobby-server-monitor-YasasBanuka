---
/**
 * Audit log page. Admin only.
 * Immutable append-only log of all destructive and configuration actions.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Audit Log">
  <div class="page-header">
    <div>
      <h1 class="page-title">Audit Log</h1>
      <p class="page-subtitle">Immutable record of all administrative actions</p>
    </div>
    <div style="display:flex;gap:8px;">
      <select id="limit-select" class="form-select" style="width:auto;">
        <option value="50">Last 50</option>
        <option value="100" selected>Last 100</option>
        <option value="250">Last 250</option>
        <option value="500">Last 500</option>
      </select>
      <button class="btn btn-secondary" id="refresh-btn">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
          <path d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7.002 7.002 0 0 1 1.05 8.84a.75.75 0 0 1 .656-.834ZM8 2.5a5.487 5.487 0 0 0-4.131 1.869l1.204 1.204A.25.25 0 0 1 4.896 6H1.25A.25.25 0 0 1 1 5.75V2.104a.25.25 0 0 1 .427-.177l1.38 1.38A7.002 7.002 0 0 1 14.95 7.16a.75.75 0 0 1-1.49.178A5.5 5.5 0 0 0 8 2.5Z"/>
        </svg>
        Refresh
      </button>
    </div>
  </div>

  <div id="access-denied" class="alert alert-error" style="display:none;">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
      <path d="M2.343 13.657A8 8 0 1 1 13.658 2.343 8 8 0 0 1 2.343 13.657ZM6.03 4.97a.751.751 0 0 0-1.042.018.751.751 0 0 0-.018 1.042L6.94 8 4.97 9.97a.749.749 0 0 0 .326 1.275.749.749 0 0 0 .734-.215L8 9.06l1.97 1.97a.749.749 0 0 0 1.275-.326.749.749 0 0 0-.215-.734L9.06 8l1.97-1.97a.749.749 0 0 0-.326-1.275.749.749 0 0 0-.734.215L8 6.94Z"/>
    </svg>
    Audit log access requires admin privileges.
  </div>

  <div id="audit-content" style="display:none;">
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Actor</th>
            <th>Action</th>
            <th>Target</th>
            <th>Detail</th>
          </tr>
        </thead>
        <tbody id="audit-table-body">
          <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px;">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>

<style>
  .action-chip {
    display: inline-flex; align-items: center;
    padding: 2px 8px; border-radius: 100px;
    font-size: 11px; font-weight: 600; font-family: 'JetBrains Mono', monospace;
    text-transform: lowercase;
  }
  .action-create  { background: rgba(63, 185, 80, 0.15); color: var(--accent-green); }
  .action-delete  { background: rgba(248, 81, 73, 0.15); color: var(--accent-red); }
  .action-resize  { background: rgba(210, 153, 34, 0.15); color: var(--accent-yellow); }
  .action-start   { background: rgba(63, 185, 80, 0.15); color: var(--accent-green); }
  .action-stop    { background: rgba(139, 148, 158, 0.15); color: var(--text-secondary); }
  .action-restart { background: rgba(56, 139, 253, 0.15); color: var(--accent-blue-light); }
  .action-invite  { background: rgba(188, 140, 255, 0.15); color: var(--accent-purple); }
  .action-revoke  { background: rgba(248, 81, 73, 0.15); color: var(--accent-red); }
  .action-assign  { background: rgba(56, 139, 253, 0.15); color: var(--accent-blue-light); }
  .action-update  { background: rgba(210, 153, 34, 0.15); color: var(--accent-yellow); }
  .action-default { background: rgba(139, 148, 158, 0.15); color: var(--text-secondary); }

  .detail-toggle {
    background: none; border: none; cursor: pointer;
    color: var(--accent-blue); font-size: 12px;
    padding: 0; text-decoration: underline;
  }

  .detail-pre {
    display: none;
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
    padding: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 6px;
    white-space: pre-wrap;
    word-break: break-all;
  }
</style>

<script>
  async function init() {
    const res = await fetch('/api/users/me');
    if (res.status === 401) { window.location.href = '/login'; return; }
    const me = await res.json();

    if (me.role !== 'admin') {
      document.getElementById('access-denied').style.display = 'flex';
      return;
    }
    document.getElementById('audit-content').style.display = 'block';
    await loadAudit();
  }

  async function loadAudit() {
    const limit = document.getElementById('limit-select').value;
    const tbody = document.getElementById('audit-table-body');

    try {
      const res = await fetch(`/api/audit?limit=${limit}`);
      if (!res.ok) return;
      const data = await res.json();
      const entries = data.entries || [];

      if (entries.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px;">No audit entries yet.</td></tr>`;
        return;
      }

      tbody.innerHTML = entries.map(e => {
        const actionPart = e.action.split('.').pop() || '';
        const cssClass = `action-${actionPart}`;
        let detail = '';
        if (e.detail) {
          try {
            const parsed = JSON.parse(e.detail);
            detail = `<button class="btn btn-sm btn-secondary" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">Details</button>
              <pre class="detail-pre">${JSON.stringify(parsed, null, 2)}</pre>`;
          } catch { detail = `<span style="font-size:11px;color:var(--text-muted)">${e.detail}</span>`; }
        }

        const time = new Date(e.created_at + 'Z');
        const timeStr = time.toLocaleString();

        return `
          <tr>
            <td style="white-space:nowrap;font-size:12px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;">${timeStr}</td>
            <td style="font-size:12px;">${e.actor || '—'}</td>
            <td><span class="action-chip ${cssClass} action-default">${e.action}</span></td>
            <td style="font-family:'JetBrains Mono',monospace;font-size:12px;">${e.target}</td>
            <td style="max-width:200px;">${detail || '—'}</td>
          </tr>
        `;
      }).join('');

    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--accent-red);padding:40px;">Failed to load audit log.</td></tr>`;
    }
  }

  document.getElementById('limit-select')?.addEventListener('change', loadAudit);
  document.getElementById('refresh-btn')?.addEventListener('click', loadAudit);

  init();
</script>
